# Suppress Portainer and Dozzle HTTP parser false positives (invalid chunk len & compression bomb)
suppress gen_id 1, sig_id 2221010
suppress gen_id 1, sig_id 2221020

# Suppress HTTP excessive header repetition noise from local monitoring containers
suppress gen_id 1, sig_id 2221024

# Suppress internal TCP RST injection alerts originating from the Pi host
suppress gen_id 1, sig_id 2210056, track by_src, ip 192.168.50.115

# Suppress benign internal Discord DNS lookup noise from workstation segment
suppress gen_id 1, sig_id 2027757, track by_src, ip 192.168.20.244
suppress gen_id 1, sig_id 2027758, track by_src, ip 192.168.20.244
